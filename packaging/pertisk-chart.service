[Unit]
Description=Pertisk Helm Chart Repository Server
Documentation=https://github.com/pertisk-tech/pertisk-chart
After=network.target

[Service]
Type=simple
User=pertisk-chart
Group=pertisk-chart
EnvironmentFile=-/etc/pertisk-chart/config.conf
ExecStart=/usr/libexec/pertisk-chart
Restart=always
RestartSec=5
LimitNOFILE=65535

# Allow binding to privileged ports if needed
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Security hardening
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pertisk-chart /var/log/pertisk-chart
PrivateTmp=true

[Install]
WantedBy=multi-user.target
